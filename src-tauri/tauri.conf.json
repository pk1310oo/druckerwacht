{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Druckerwacht",
  "version": "0.6.1",
  "identifier": "de.druckerwacht.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Druckerwacht",
        "width": 1320,
        "height": 860,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "backgroundColor": "#0F0F0F",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "dmg",
      "app"
    ],
    "category": "Utility",
    "shortDescription": "Live-Überwachung für Creality-3D-Drucker",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "resources": [
      "resources/profiles/**/*"
    ]
  }
}